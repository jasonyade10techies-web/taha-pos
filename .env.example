# Custom shop API. Copy to ignored .env.local. No server secrets belong here.
VITE_DATA_PROVIDER=api
VITE_USE_MOCK_AUTH=false
# Same-origin deployment and Vite proxy use /api/v1.
VITE_API_URL=/api/v1
# Independent device bridge: works with local or API business repositories.
# Use the backend origin (e.g. http://PC-LAN-IP:3001) for LAN test builds,
# or /api/v1 through the counter's configured same-origin proxy.
VITE_API_BASE_URL=/api/v1
# Local demo: VITE_DATA_PROVIDER=local and VITE_USE_MOCK_AUTH=true.
# Optional legacy Supabase adapter, only when explicitly selecting provider=supabase.
# Your real Supabase project URL. Never invent a value here.
VITE_SUPABASE_URL=
# Current public client key (sb_publishable_...). Never use sb_secret_ or service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy anon JWT, only if your project still uses it. Prefer publishable.
VITE_SUPABASE_ANON_KEY=
# Enable only after Google provider and redirect URLs are configured in Supabase.
VITE_SUPABASE_GOOGLE_ENABLED=false

# Optional independently authenticated LAN camera/device bridge.
VITE_DEVICE_BRIDGE_URL=
# Production Android shop origin (HTTPS). Leave empty for manual test setup.
VITE_MOBILE_SHOP_URL=

# Native release PUBLIC endpoint. Supply in the build shell for Cargo; never a secret.
# Release requires HTTPS. Do not use a shop LAN IP for this value.
TAHA_API_URL=
