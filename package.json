{
  "name": "taha-pos",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "node scripts/test-frontend.mjs",
    "test:ui": "playwright test --ui",
    "test:local": "playwright test --config playwright.local.config.ts",
    "test:reconciliation": "playwright test --config playwright.reconciliation.config.ts",
    "verify:release": "node scripts/release-checks.mjs",
    "test:release-tools": "node --test scripts/release-checks.test.mjs",
    "test:auth:local": "node scripts/test-refresh-coordination.mjs --reload",
    "test:production": "node scripts/smoke-live-production.mjs",
    "test:production:local": "node scripts/smoke-local-production.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "preview:demo": "vite preview --host 127.0.0.1 --port 4174 --outDir dist-demo",
    "test:security": "node scripts/test-security.mjs && node scripts/test-stock-backend.mjs && node scripts/test-transactions.mjs",
    "test:transactions": "node scripts/test-transactions.mjs",
    "test:concurrency": "node scripts/test-concurrency.mjs",
    "test:client-boundary": "node scripts/test-client-boundary.mjs",
    "validate:migrations": "node scripts/check-migrations.mjs",
    "validate:tauri": "node scripts/validate-tauri.mjs",
    "build:mobile": "node scripts/build-mobile.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "dev:mobile": "node scripts/start-mobile-preview.mjs",
    "test:desktop": "node --test scripts/test-desktop-sqlite.mjs",
    "package:managed": "node scripts/package-managed.mjs",
    "test:release-system": "node --test scripts/test/*.test.mjs scripts/ci/*.test.mjs scripts/security/*.test.mjs",
    "release:android": "node scripts/android-release.mjs",
    "scan:secrets": "node scripts/security/scan-secrets.mjs",
    "build:hostinger": "node scripts/build-hostinger.mjs",
    "start:hostinger": "node server/hostinger.cjs",
    "downloads:start": "node distribution/server.mjs",
    "ci:package": "node scripts/ci/test-managed-package.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/manrope": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.90.2",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-deep-link": "^2.6.1",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-window-state": "^2.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "dompurify": "^3.4.17",
    "framer-motion": "^12.23.22",
    "fuse.js": "^7.5.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^22.18.8",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "ajv": "^8.17.1",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.23",
    "fflate": "0.8.3",
    "globals": "^16.4.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.9"
  },
  "engines": {
    "node": ">=22.13 <23 || >=24 <25"
  }
}
