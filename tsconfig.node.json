{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext", "jsx":"react-jsx",
    "skipLibCheck": true, "moduleResolution": "bundler", "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true, "isolatedModules": true, "noEmit": true, "strict": true,
    "types": ["node","vite/client"]
  },
  "include": ["vite.config.ts", "playwright.config.ts", "playwright.local.config.ts", "playwright.r1-api.config.ts", "playwright.r2a-api.config.ts", "tests"]
}
