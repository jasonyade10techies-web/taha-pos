NODE_ENV=production
TAHA_RUNTIME=cloud
TAHA_DEPLOYMENT_ENV=staging
TAHA_SERVE_FRONTEND=true
TAHA_BIND_HOST=0.0.0.0
DATABASE_POOL_MAX=2
# Set only after Hostinger confirms the reverse-proxy source range. Never true/*.
TAHA_TRUST_PROXY=
# Hostinger assigns PORT. Do not force the LAN development port.
PUBLIC_API_URL=
FRONTEND_ORIGIN=
MOBILE_APP_ORIGIN=http://localhost
DATABASE_URL=
MIGRATION_DATABASE_URL=
MIGRATE_ON_START=false
JWT_SECRET=
COOKIE_SECURE=true
# Prefer private external object storage if host storage persistence is unconfirmed.
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Cloud software releases use the same private bucket, strictly under
# software-releases/v1/. No permanent uploads or release files in deploy dirs.
# Optional separate software origin; normally leave empty for same-origin.
ANDROID_DOWNLOAD_ORIGIN=
