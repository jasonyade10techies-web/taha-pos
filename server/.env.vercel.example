# Configure in the BACKEND Vercel project only. Values here are deliberately blank.
# Actual generated project domains are required; do not deploy these examples as values.
NODE_ENV=production
TAHA_DEPLOYMENT_ENV=staging
TAHA_RUNTIME=cloud
DATABASE_URL=
DATABASE_POOL_MAX=2
JWT_SECRET=
FRONTEND_ORIGIN=
PUBLIC_API_URL=
STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# MIGRATION_DATABASE_URL belongs only to the trusted one-shot migration runner,
# never the public frontend and preferably never the deployed runtime environment.
