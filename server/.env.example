NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://taha_api:CHANGE_ME@localhost:5432/taha_pos
# Use a different migration owner credential; never give runtime the migration owner login.
MIGRATION_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/taha_pos
# At least 32 random bytes. No development default is accepted.
JWT_SECRET=
FRONTEND_ORIGIN=http://localhost:1420,http://127.0.0.1:1420
# Explicit bundled Android origin; REST auth and WebSocket checks use the same allowlist.
MOBILE_APP_ORIGIN=http://localhost
PUBLIC_API_URL=http://localhost:3000
STORAGE_ROOT=./data/media
COOKIE_SECURE=false
# Optional standards-based Web Push; generated using npx web-push generate-vapid-keys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
# Docker Compose only (strong URL-safe values; never commit real passwords).
POSTGRES_PASSWORD=
API_DATABASE_PASSWORD=

# Production reverse proxy only. Real values are provided on the VPS.
APP_DOMAIN=
API_DOMAIN=
ACME_EMAIL=
