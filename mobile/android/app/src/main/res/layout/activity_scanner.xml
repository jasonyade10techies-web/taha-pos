<?xml version="1.0" encoding="utf-8"?>
<!-- A concrete root is required for system insets and the preview's sibling frame bounds. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scanner_root" android:layout_width="match_parent" android:layout_height="match_parent" tools:ignore="MergeRootFrame">

    <com.tahamobiles.staff.NativeBarcodeView android:id="@+id/scanner_preview"
        android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" />
    <com.tahamobiles.staff.ScannerViewfinder android:id="@+id/scanner_viewfinder"
        android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAccessibility="no" />

    <LinearLayout android:id="@+id/scanner_header" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="top" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp"
        android:paddingTop="12dp" android:paddingBottom="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageButton android:id="@+id/scanner_back" android:layout_width="48dp" android:layout_height="48dp"
                android:background="@drawable/scanner_control_background" android:padding="12dp"
                android:src="@drawable/ic_scanner_back" android:contentDescription="@string/scanner_back" />
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <ImageButton android:id="@+id/scanner_flash" android:layout_width="48dp" android:layout_height="48dp"
                android:background="@drawable/scanner_control_background" android:padding="12dp"
                android:src="@drawable/ic_scanner_flash" android:contentDescription="@string/scanner_flash_on" />
        </LinearLayout>
        <TextView android:id="@+id/scanner_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/scanner_qr_title" android:textColor="#FFFFFF"
            android:textSize="28sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/scanner_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="@string/scanner_qr_subtitle" android:textColor="#C5CBD3" android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/scanner_footer" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical" android:gravity="center_horizontal"
        android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="16dp" android:paddingBottom="28dp">
        <TextView android:id="@+id/scanner_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/scanner_qr_hint" android:textColor="#F0F2F5" android:textSize="14sp" android:gravity="center" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:text="@string/scanner_automatic" android:textColor="#AAB1BD" android:textSize="12sp" android:gravity="center" />
        <LinearLayout android:layout_width="280dp" android:layout_height="56dp" android:layout_marginTop="24dp"
            android:orientation="horizontal" android:padding="4dp" android:background="@drawable/scanner_segment_background">
            <Button android:id="@+id/scanner_auto" style="?android:attr/buttonBarButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/scanner_mode_background" android:backgroundTint="@null" android:text="@string/scanner_auto_mode" android:textAllCaps="false" android:textSize="14sp" android:minHeight="0dp" android:minWidth="0dp" android:padding="0dp" android:textColor="#171A20"/>
            <Button android:id="@+id/scanner_qr" style="?android:attr/buttonBarButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:background="@drawable/scanner_mode_background" android:backgroundTint="@null" android:text="@string/scanner_qr_mode"
                android:textAllCaps="false" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:minHeight="0dp" android:minWidth="0dp"
                android:padding="0dp" android:textColor="#171A20" />
            <Button android:id="@+id/scanner_barcode" style="?android:attr/buttonBarButtonStyle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:background="@drawable/scanner_mode_background" android:backgroundTint="@null" android:text="@string/scanner_barcode_mode"
                android:textAllCaps="false" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:minHeight="0dp" android:minWidth="0dp"
                android:padding="0dp" android:textColor="#AAB1BD" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
